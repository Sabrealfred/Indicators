<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Same split as backup_rules.xml: the creature travels, the key stays. See PetRepository. -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/neopal_secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/neopal_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
