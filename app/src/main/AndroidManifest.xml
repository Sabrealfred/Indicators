<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Care reminders while the app is closed. Optional: the game runs fine without it. -->
    <!--
        Needed only by the remote brain, which is off by default and inert until the player sets
        a route. Everything else in this app (the whole simulation, all of the art, all of the
        audio) runs with no network at all, and did so with no INTERNET permission before this
        line existed. Anyone reading the manifest to find out what leaves the device should find
        the answer here: nothing, unless the creature has been given somewhere to think.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        The creature listens only while the player is holding the button down, and only if this
        is granted at runtime. `CreatureEars` checks for it on every call and degrades to the
        keyboard when it is absent, so a refusal costs the talking, not the app.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Needed to hand a downloaded APK to the system installer. It grants nothing on its own:
        the player still has to allow this app as an install source in Settings, and then has to
        approve the install itself on the system's own screen. Without the permission the
        approval screen cannot even be reached, and the updater falls back to opening the
        release page in a browser.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Declared here rather than left to arrive transitively.

        WorkManager's own manifest already merges this in, so the app has had it all along and
        `ConnectivityManager` has been answering honestly. That is a fragile way to hold a
        permission the updater and the model downloader both make decisions with: the day a
        dependency changes, the failure is silent — every connection starts reading as metered,
        the automatic update check stops happening, and the model download asks for permission to
        spend mobile data that it is sitting on Wi-Fi to avoid. Nothing crashes and nothing says
        anything, which is the exact shape of failure this project has already shipped twice.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A model file is one to three gigabytes and takes as long as it takes. The download runs as
        a foreground service so that leaving the app does not kill it, and so that an hour of
        somebody's connection and battery is visible in the shade rather than spent invisibly.

        `dataSync` is the type: a long transfer the player asked for by name. From API 34 the type
        must be declared, and both the permission and the service entry below have to agree with
        the `ForegroundInfo` the worker returns.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        Package visibility, API 30 and up. Text-to-speech and speech recognition are provided by
        other apps; without these entries `queryIntentServices` returns nothing and the creature
        appears mute and deaf on a device that is neither. Narrow by design — this asks about two
        service actions, not for the list of what is installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!--
        usesCleartextTraffic: minSdk is 24, and the "no cleartext by default" rule is enforced by
        platform code that only exists from API 28. On 24 to 27 the default is still permissive,
        so a player who pastes an http endpoint into settings would send their bearer token in
        plain text. This attribute is honoured from API 23, which covers the gap.
    -->
    <application
        android:name=".NeoPalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.NeoPal">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NeoPal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The action button on a care notification. Not exported: the only thing that can send
            to it is a PendingIntent this app built. Android requires the flag to be explicit
            from API 31, and stating it here rather than relying on the default is what makes
            that non-negotiable.
        -->
        <receiver
            android:name=".data.NudgeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="neopal.nudge.MEDICINE" />
            </intent-filter>
        </receiver>

        <!--
            The home-screen creature. Exported because the platform is what delivers
            APPWIDGET_UPDATE; nothing else is advertised, and the two intents the widget sends
            itself are explicit and need no filter of their own.

            Exported does mean another app could send the explicit care intent and feed the
            pet. Everything crossing that boundary is re-validated against the save on arrival,
            so nothing invalid can happen — but a stranger could spend a Sushi Set.
        -->
        <receiver
            android:name=".widget.PetWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pet_info" />
        </receiver>

        <!--
            WorkManager brings its own foreground service; what it cannot know is what this app
            uses it for. `tools:node="merge"` adds the type to the entry the library declares
            rather than replacing it, which is what API 34 and up require before the service may
            start at all.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
            Hands the downloaded APK to the installer as a content:// URI. A file:// URI would
            throw FileUriExposedException on anything from API 24 up, which is every device this
            app runs on.

            The authority must match UpdateService.PROVIDER_SUFFIX, and it is built from
            ${applicationId} rather than written out, because the debug build appends `.debug`
            and a hard-coded authority would collide with the release build if both were
            installed — the second install would simply fail.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
